FROM alpine:3.19

# Security: Install PostgreSQL client 16, OpenSSL, Bash, Gzip, Curl, AWS CLI
RUN apk add --no-cache \
    bash \
    postgresql16-client \
    openssl \
    gzip \
    curl \
    aws-cli \
    busybox-suid \
    findutils \
    coreutils \
    && addgroup -g 10001 backupgroup \
    && adduser -u 10001 -G backupgroup -D backupuser

# Create backup directory & assign permissions
WORKDIR /app
RUN mkdir -p /backups && chown -R backupuser:backupgroup /backups /app

# Copy backup script and crontab
COPY --chown=backupuser:backupgroup devops/scripts/backup_restore.sh /app/backup_restore.sh
COPY devops/docker/crontab /etc/crontabs/root

RUN chmod +x /app/backup_restore.sh && chmod 0644 /etc/crontabs/root

USER 10001:10001

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD pgrep crond || exit 1

# Entrypoint runs cron daemon in foreground
CMD ["crond", "-f", "-l", "2"]
