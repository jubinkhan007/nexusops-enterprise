FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY backend-dotnet/src/NexusOps.Domain/ *.csproj ./NexusOps.Domain/
COPY backend-dotnet/src/NexusOps.Application/ *.csproj ./NexusOps.Application/
COPY backend-dotnet/src/NexusOps.Infrastructure/ *.csproj ./NexusOps.Infrastructure/
COPY backend-dotnet/src/NexusOps.Api/ *.csproj ./NexusOps.Api/

COPY backend-dotnet/src/ .
RUN dotnet publish NexusOps.Api/NexusOps.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENTRYPOINT ["dotnet", "NexusOps.Api.dll"]
