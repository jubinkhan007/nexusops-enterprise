# ==============================================================================
# NexusOps Enterprise - Production Environment Variable Configuration Blueprint
# IMPORTANT: Copy this file to .env.production on production servers and populate with secrets.
# ==============================================================================

# Core Application Environment
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production
FASTAPI_ENV=production

# Network & Gateway Ports
DOTNET_PORT=5000
FASTAPI_PORT=8000
FRONTEND_PORT=3000

# High-Availability PostgreSQL Database Settings
POSTGRES_HOST=postgres.nexusops.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=nexusops_enterprise_db
POSTGRES_USER=nexusops_admin
POSTGRES_PASSWORD=YOUR_SECURE_PRODUCTION_DB_PASSWORD_HERE
POSTGRES_SSLMODE=verify-full

# Distributed Redis Cache Settings
REDIS_HOST=elasticache-redis.nexusops.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_AUTH_TOKEN_HERE
REDIS_SSL=true

# Apache Kafka Event Saga Bus
KAFKA_BOOTSTRAP_SERVERS=kafka-cluster.nexusops.svc.cluster.local:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=nexusops-saga-client
KAFKA_SASL_PASSWORD=YOUR_SECURE_KAFKA_SASL_PASSWORD_HERE

# Security & Jwt Authentication
JWT_SECRET=YOUR_SECURE_SUPER_SECRET_HMAC_SHA256_JWT_KEY_MIN_64_CHARS_LONG_HERE
JWT_ISSUER=https://auth.nexusops.enterprise.io
JWT_AUDIENCE=https://api.nexusops.enterprise.io
JWT_EXPIRATION_MINUTES=60

# WAF & CORS Security Headers
ALLOWED_CORS_ORIGINS=https://console.nexusops.enterprise.io,https://admin.nexusops.enterprise.io
ENABLE_STRICT_WAF=true
WAF_RATE_LIMIT_PER_MINUTE=1000

# Incident Management & PagerDuty Integration
PAGERDUTY_API_KEY=YOUR_SECURE_PAGERDUTY_INTEGRATION_KEY_HERE
PAGERDUTY_SERVICE_ID=YOUR_PAGERDUTY_SERVICE_ID_HERE
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/WEBHOOK

# AWS / Multi-Region Cloud Credentials
AWS_REGION=us-east-1
SECONDARY_AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# OpenTelemetry Telemetry Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://opentelemetry-collector.nexusops.svc.cluster.local:4317
OTEL_SERVICE_NAME=nexusops-enterprise-cluster
